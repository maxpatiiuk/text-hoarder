{
  "name": "text-hoarder",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxpatiiuk/text-hoarder.git"
  },
  "author": "Max Patiiuk",
  "homepage": "https://github.com/maxpatiiuk/text-hoarder/blob/main/docs/cli.md",
  "bugs": {
    "url": "https://github.com/maxpatiiuk/text-hoarder/issues/new/choose"
  },
  "bin": {
    "text-hoarder": "./packages/cli/dist/cli.bundle.js"
  },
  "scripts": {
    "build": "vite build --config vite.cli.config.ts && vite build --config vite.web.config.ts",
    "package:extension": "tsc && vite build --config vite.extension.config.ts && cd packages/browser-extension && zip -FSr text-hoarder.zip dist public options.html manifest.json",
    "publish:cli": "tsc && vite build --config vite.cli.config.ts && vite build --config vite.web.config.ts && cd packages/cli/dist && npm publish",
    "watch": "vite build --config vite.cli.config.ts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^12.0.0",
    "@joplin/turndown": "^4.0.72",
    "@joplin/turndown-plugin-gfm": "^1.0.54",
    "@mozilla/readability": "^0.5.0",
    "@types/turndown": "^5.0.4",
    "chart.js": "^4.4.1",
    "commander": "^12.0.0",
    "github-markdown-css": "^5.5.1",
    "glob": "^10.3.10",
    "marked": "^15.0.4",
    "octokit": "^3.1.2",
    "open": "^10.0.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "simple-git": "^3.22.0",
    "typesafe-reducer": "^1.0.4"
  },
  "devDependencies": {
    "@maxxxxxdlp/eslint-config": "^5.0.0",
    "@maxxxxxdlp/eslint-config-react": "^3.0.0",
    "@maxxxxxdlp/prettier-config": "^1.0.4",
    "@types/chrome": "^0.0.260",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.56",
    "@types/react-devtools": "^3.6.2",
    "@types/react-dom": "^18.2.19",
    "@tailwindcss/postcss": "^4.2.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.56.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react-devtools": "^5.3.2",
    "tailwindcss": "^4.2.1",
    "vitest": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "browserslist": {
    "production": [
      "last 2 years",
      "> 1% in US",
      "not ie <= 11",
      "not dead"
    ],
    "development": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 1 Safari version"
    ]
  },
  "prettier": "@maxxxxxdlp/prettier-config"
}
